<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sentinel.Infrastructure\Sentinel.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Sentinel.Migrations.SqlServer\Sentinel.Migrations.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every fixture starts its own SQL Server 2025 / Redis container. Starting several at once on one machine
         starves them, and startup timeouts surface as skipped tests that would silently hide coverage. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.Redis" />
  </ItemGroup>
</Project>
